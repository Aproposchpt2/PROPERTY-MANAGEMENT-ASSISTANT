{
  "expo": {
    "name": "Property Management Assistant",
    "slug": "property-management-assistant",
    "scheme": "pma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellar.pma"
    },
    "android": {
      "package": "com.stellar.pma",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "Property Management Assistant",
      "description": "Request maintenance, follow your case, and manage property incidents.",
      "themeColor": "#050505"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8A84B"
        }
      ],
      "expo-font"
    ]
  }
}
